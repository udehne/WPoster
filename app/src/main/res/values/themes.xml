<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WPoster" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Startbild: Logo auf Tintenblau, danach das normale App-Theme. -->
    <style name="Theme.WPoster.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WPoster</item>
    </style>
</resources>
